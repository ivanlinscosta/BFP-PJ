# Secrets are never committed. The Anthropic API key must be stored only in AWS Secrets Manager.

# --- web (Vite) ---
VITE_API_BASE_URL=/api
VITE_AWS_REGION=sa-east-1

# --- api ---
AUTH_MODE=dev
# JWT_SECRET é usado apenas para os tokens HS256 locais de AUTH_MODE=dev.
# Nunca mantenha o valor padrão fora do desenvolvimento local.
JWT_SECRET=dev-only-secret-change-me
AWS_REGION=sa-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Leave these blank in local dev to use the in-memory dataset/object repositories.
DATASET_TABLE=
OBJECTS_TABLE=
ANTHROPIC_API_KEY=
ANTHROPIC_SECRET_NAME=bfp/dev/anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
DATA_PATH=../../data/dataset.json
# RATE_LIMIT_ENABLED=false é suportado apenas em NODE_ENV=test.

# --- data mesh e integrações (ver docs/data-mesh-and-integrations.md) ---
# local = definições do pacote; glue = Glue Data Catalog + Lake Formation (padrão com ANALYTICS_ENGINE=athena)
MESH_CATALOG=local
MESH_DATABASE_PREFIX=bfp_pj_dev
DATAZONE_DOMAIN_ID=
ATLAN_SECRET_ID=
FULLSTORY_SECRET_ID=
DATA_LOADED_AT_PARAMETER=
